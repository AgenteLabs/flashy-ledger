{
  "name": "@flashylabs/ledger",
  "version": "1.0.0",
  "description": "Append-only, multi-asset settlement ledger. Storage-agnostic by construction.",
  "keywords": [
    "settlement ledger",
    "agent settlement",
    "audit receipt",
    "append-only ledger",
    "hash chain",
    "merkle anchoring",
    "chain-neutral",
    "interorganizational ledger",
    "AAO settlement",
    "Flashy Anchor Protocol",
    "verifiable autonomous action",
    "proof of authorization"
  ],
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist-cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist-cjs/index.js"
    }
  },
  "files": [
    "dist",
    "dist-cjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.cjs.json && node scripts/stamp-cjs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint src tests",
    "test:standalone": "node --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run coverage && npm run test:standalone",
    "prepare": "npm run build",
    "bolt": "node scripts/bolt.mjs",
    "directory": "node scripts/directory.mjs",
    "directory:check": "node scripts/directory.mjs && node scripts/check-directory.mjs --external person/michael"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^9.17.0",
    "mongodb": "^6.21.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "mongodb": "^6.21.0 || ^7.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FlashyLabs/flashy-ledger.git"
  },
  "peerDependenciesMeta": {
    "mongodb": {
      "optional": true
    }
  },
  "module": "./dist/index.js",
  "packageManager": "npm@10.9.8"
}
